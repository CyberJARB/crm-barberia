APP_NAME="CRM Barberías"
APP_ENV=production
APP_KEY=                          # Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://tudominio.com

APP_LOCALE=de
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

# === SEGURIDAD (OWASP A05 / CWE-16) ===
BCRYPT_ROUNDS=12
APP_HIDE_SERVER_INFO=true

# === LOGGING (ISO 27001 A.12.4) ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SECURITY_CHANNEL=daily

# === BASE DE DATOS ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_barberia
DB_USERNAME=                      # NO usar root en producción
DB_PASSWORD=                      # Mínimo 20 chars aleatorios

# === SESIÓN (OWASP A07 / CWE-384) ===
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true        # Siempre true en producción (HTTPS)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# === CACHE / QUEUE ===
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# === CORREO (configurar según proveedor SMTP) ===
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

# === RECAPTCHA v3 (obtener en console.cloud.google.com) ===
RECAPTCHA_SITE_KEY=           # Clave del sitio (pública, va en el JS)
RECAPTCHA_SECRET_KEY=         # Clave secreta (solo servidor, NUNCA expongas en frontend)
RECAPTCHA_MIN_SCORE=0.5       # 0.0 = probablemente bot, 1.0 = probablemente humano

# === STRIPE / CASHIER (suscripciones) ===
# NUNCA exponer STRIPE_SECRET ni STRIPE_WEBHOOK_SECRET en frontend/logs (CWE-532)
STRIPE_KEY=pk_test_REEMPLAZAR
STRIPE_SECRET=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
# Price IDs de Stripe (dashboard.stripe.com -> Products) — allowlist OWASP A04
STRIPE_PRICE_BASICO=price_REEMPLAZAR
STRIPE_PRICE_PROFESIONAL=price_REEMPLAZAR
STRIPE_PRICE_PREMIUM=price_REEMPLAZAR
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=de_DE

# === WHATSAPP API (gated por plan) ===
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Contraseña del admin demo creado por AdminSeeder (vacío = se genera una aleatoria)
ADMIN_SEED_PASSWORD=
SAAS_SOPORTE_WHATSAPP=
