# ============================================================
# PLANTILLA DE PRODUCCIÓN — CRM Barberías (DSGVO / Alemania)
# Copiar a .env en el servidor. NUNCA commitear el .env real.
# Tras editar: php artisan config:cache && php artisan route:cache
# ============================================================

APP_NAME="CRM Barberías"
APP_ENV=production
APP_KEY=                          # php artisan key:generate — rotar solo con plan (ver SECURITY_HARDENING_REPORT.md)
APP_DEBUG=false                   # OWASP A05 / CWE-209 — NUNCA true en producción
APP_URL=https://app.tudominio.de  # Debe ser https:// (HSTS activo)

APP_LOCALE=de
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

# === SEGURIDAD (OWASP A05) ===
BCRYPT_ROUNDS=12
APP_HIDE_SERVER_INFO=true

# === LOGGING (ISO 27001 A.12.4 / GDPR Art. 5(1)(e)) ===
LOG_CHANNEL=stack
LOG_STACK=daily                   # daily + rotación, no single (crece sin límite)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                 # Sin debug/info en producción (CWE-532)
LOG_DAILY_DAYS=30
SEC_LOG_RETENTION_DAYS=90

# === BASE DE DATOS (OWASP A05) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                 # Solo localhost o red privada; nunca expuesta a internet
DB_PORT=3306
DB_DATABASE=crm_barberia
DB_USERNAME=                      # Usuario dedicado con permisos mínimos (NO root, sin GRANT/FILE/SUPER)
DB_PASSWORD=                      # Mínimo 20 chars aleatorios: openssl rand -base64 24

# === SESIÓN (OWASP A07 / CWE-384 / CWE-614) ===
SESSION_DRIVER=database
SESSION_LIFETIME=480              # 8h jornada; reducir si el riesgo lo exige
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true        # Obligatorio con HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax             # 'strict' rompe links externos al panel; lax es el equilibrio
SESSION_DOMAIN=null

# === MFA / 2FA (OWASP A07 / NIST 800-63B AAL2) ===
SEC_MFA_REQUIRED=true             # Obliga a configurar TOTP a todo usuario del panel (exigido por Cyber-Versicherer)

# === IP allowlist del panel /super (Zero Trust / OWASP A01) ===
SEC_SUPER_IP_ALLOWLIST=           # IPs/CIDR del operador separadas por coma. Vacío=sin restricción. Ej: 203.0.113.5,10.0.0.0/24

# === Cierre de sesión por inactividad (Zero Trust / OWASP A07) ===
SEC_SESSION_IDLE_TIMEOUT=30        # Minutos de inactividad antes de exigir re-login. 0=desactivado

# === RATE LIMITING (OWASP A07 / CWE-770) ===
SEC_LOGIN_MAX_ATTEMPTS=5
SEC_LOGIN_DECAY_MINUTES=15
SEC_WEB_READS_PER_MINUTE=300
SEC_WEB_WRITES_PER_MINUTE=180
SEC_API_PER_MINUTE=120

# === CSP (OWASP A03) ===
SEC_CSP_ENABLED=true

# === CACHE / QUEUE ===
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local             # NUNCA 'public' para datos de clientes
QUEUE_CONNECTION=database         # Worker via systemd: php artisan queue:work --max-time=3600
CACHE_STORE=database

# === CORREO ===
MAIL_MAILER=smtp
MAIL_SCHEME=tls                   # OWASP A02 — TLS obligatorio
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tudominio.de
MAIL_FROM_NAME="${APP_NAME}"

# === RECAPTCHA v3 ===
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=             # Solo servidor — NUNCA en frontend
RECAPTCHA_MIN_SCORE=0.5

# === STRIPE / CASHIER ===
STRIPE_KEY=                       # pk_live_... (clave publicable, modo live)
STRIPE_SECRET=                    # sk_live_... — NUNCA en frontend ni logs (CWE-532)
STRIPE_WEBHOOK_SECRET=            # Obligatorio — valida firma de webhooks (CWE-345)
                                  # Crear con: php artisan cashier:webhook
# Price IDs (modo live) — allowlist contra manipulación de precios (OWASP A04 / CWE-639)
STRIPE_PRICE_BASICO=              # Basis 29 €/Monat
STRIPE_PRICE_PROFESIONAL=         # Professionell 59 €/Monat
STRIPE_PRICE_PREMIUM=             # Premium 99 €/Monat
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=de_DE

# === WHATSAPP API ===
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
